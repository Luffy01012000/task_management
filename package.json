{
  "name": "task-manager",
  "version": "1.0.0",
  "description": "Root workspace: MERN + TypeScript Task Manager (backend + frontend)",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "frontend/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:backend": "pnpm --filter backend build:prod",
    "build:frontend": "pnpm --filter frontend build",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:backend": "pnpm --filter backend lint",
    "lint:frontend": "pnpm --filter frontend lint",
    "prepare": "husky"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}
